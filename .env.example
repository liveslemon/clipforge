# ClipForge configuration — copy to `.env` (same folder) and fill in what you have.
# Every key is optional: missing ones fall back to a local/offline path. See SETUP.md for how to get each.

# --- Captions: hosted speech-to-text (Module 3) ---------------------------------
# https://www.assemblyai.com/dashboard  → API keys
ASSEMBLYAI_API_KEY=

# --- LLM: clip selection, titles, caption proofreading (Modules 3 & 7) -----------
# OpenAI (recommended): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional): https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# CLIPFORGE_LLM_MODEL=claude-opus-5-5

# --- Twitch import via the official Helix API (Module 1) ------------------------
# https://dev.twitch.tv/console → Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Only for downloading clips: a broadcaster/editor user token with editor:manage:clips or channel:manage:clips
TWITCH_USER_ACCESS_TOKEN=

# --- YouTube Shorts uploads (Module 10) -----------------------------------------
# Google Cloud Console → YouTube Data API v3 → OAuth client ID (Desktop app) → download JSON
YOUTUBE_CLIENT_SECRETS_FILE=
# then run once:  .venv/bin/python -m modules.module_10_publishing.youtube_auth
# YOUTUBE_TOKEN_FILE=.youtube_token.json

# --- TikTok uploads (Module 10) --------------------------------------------------
# developers.tiktok.com → app with Login Kit + Content Posting API (scopes video.upload, video.publish)
TIKTOK_ACCESS_TOKEN=

# --- Optional -------------------------------------------------------------------
# Local Whisper fallback model (mlx/faster-whisper): large-v3-turbo (default), medium, small
# CLIPFORGE_WHISPER_MODEL=large-v3-turbo
# Hugging Face token: faster, unthrottled model downloads
HF_TOKEN=
